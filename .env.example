# URL of the standalone backend API.
# Leave unset for local dev (Vite's dev server proxies /api and /screenshots
# to http://localhost:5000 automatically - see vite.config.js).
# In production, set this to your deployed backend's public URL, no trailing slash.
# Example: VITE_API_URL=https://api.example.com
VITE_API_URL=

# Cloudflare Turnstile SITE key (public, safe to ship in the frontend bundle).
# Create a widget for free at https://dash.cloudflare.com/?to=/:account/turnstile
# Must match the SECRET key configured on the backend (TURNSTILE_SECRET_KEY).
VITE_TURNSTILE_SITE_KEY=
